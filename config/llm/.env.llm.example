# LLM runtime configuration template for LLM-OA-QMIX
# Copy this file to `epymarl/config/llm/.env.llm.local` and fill in your API credentials.
# Never commit real API keys.

# Provider selection: openai_compatible | openai | modelscope | ollama
LLM_PROVIDER=openai_compatible

# Endpoint / auth (e.g. https://api.deepseek.com/v1 or https://api.openai.com/v1)
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=YOUR_API_KEY_HERE
LLM_MODEL=YOUR_MODEL_NAME_HERE
LLM_ORGANIZATION=
LLM_PROJECT=

# Request behavior
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=120

# Retry policy
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=2

# Optional reasoning/thinking control (e.g. false for DeepSeek/Qwen fast JSON mode)
LLM_ENABLE_THINKING=false

# OpenAI-compatible structured output toggle
LLM_USE_RESPONSE_FORMAT=false
LLM_RESPONSE_FORMAT=json_object
LLM_EXPECTED_KEYS=name,description,reward_mode,subreward_keys,allowed_context_keys,strategy,metadata

# Artifact policy
LLM_OUTPUT_SPEC_ID_PREFIX=maca_uav_battle_llm
LLM_OUTPUT_NAME_PREFIX=maca_uav_battle_llm
LLM_SAVE_RAW_PROMPT=true
LLM_SAVE_RAW_RESPONSE=true
LLM_SAVE_PARSED_SPEC=true
LLM_GENERATED_SPEC_DIR=./results/llm/generated_specs
